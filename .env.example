# En développement, Vite transmet /api au serveur Node local (npm run backend:start).
# En production, définir l’URL publique du backend avant la compilation du frontend :
# VITE_CUSTOM_API_URL=https://votre-backend.example/api
#
# Variables lues par le serveur Node (backend/server.js) :
# FRONTEND_ORIGINS=https://votre-site.vercel.app
# POKEDEX_DATABASE_PATH=/chemin/absolu/vers/pokedex.sqlite
# HOST=0.0.0.0
# PORT=8000
